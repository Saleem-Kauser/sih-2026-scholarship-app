# DigiLocker Sandbox backend configuration (server-side only).
# Copy to .env and fill in local values. NEVER commit .env or put these in Expo/React Native code.

# Feature flag: must be "true" to make real Sandbox calls
DIGILOCKER_SANDBOX_ENABLED=false

# REQUIRED: DigiLocker Sandbox OAuth access token (sent as "Authorization: Bearer <token>")
DIGILOCKER_ACCESS_TOKEN=

# REQUIRED for full verification: base URL of the Sandbox "Get Certificate Data in XML Format" API.
# The request URL is <this value>/<document uri>. Take it from the Sandbox request sample.
# (DigiLocker partner spec path pattern: <host>/public/oauth2/1/xml  -- host must be confirmed for the Sandbox.)
DIGILOCKER_XML_ENDPOINT=

# Optional overrides
# DIGILOCKER_SANDBOX_BASE_URL=https://dev-meripehchaan.dl6.in
PORT=3001

# Server-side JAGO Gemini assistant. Never expose these through EXPO_PUBLIC_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# JAGO chat limits (safe defaults are applied when empty).
JAGO_RATE_LIMIT_WINDOW_MS=
JAGO_RATE_LIMIT_MAX=
JAGO_SESSION_LIMIT_WINDOW_MS=
JAGO_SESSION_LIMIT_MAX=
JAGO_MAX_MESSAGE_LENGTH=